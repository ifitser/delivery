{
  "name": "delivery",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @delivery/api\" \"npm run dev -w @delivery/web\"",
    "dev:api": "npm run dev -w @delivery/api",
    "dev:web": "npm run dev -w @delivery/web",
    "build": "npm run build -w @delivery/api && npm run build -w @delivery/web",
    "test": "npm run test -w @delivery/api",
    "typecheck": "npm run typecheck -w @delivery/api && npm run typecheck -w @delivery/web",
    "db:migrate": "npm run db:migrate -w @delivery/api",
    "db:seed": "npm run db:seed -w @delivery/api",
    "db:backup": "npm run db:backup -w @delivery/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
