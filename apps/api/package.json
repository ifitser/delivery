{
  "name": "@delivery/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^4.0.5",
    "@whiskeysockets/baileys": "6.7.24",
    "@hapi/boom": "^10.0.1",
    "qrcode": "^1.5.4",
    "pino": "^9.9.5",
    "@fastify/static": "^10.1.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@types/qrcode": "^1.5.5"
  }
}
